{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "/updates/appcast.xml",
      "headers": {
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "/releases/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/download/?",
      "dest": "/download/index.html",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/download/file",
      "headers": {
        "Location": "/releases/0.6.0/Mouthtype-0.6.0-macos-arm64.dmg",
        "Cache-Control": "no-store"
      },
      "status": 302
    },
    {
      "src": "/source",
      "headers": {
        "Location": "/releases/0.6.0/Mouthtype-0.6.0-source.tar.gz",
        "Cache-Control": "no-store"
      },
      "status": 302
    }
  ]
}
