import QtQuick
import QtTest
import "../design"
import "../transform"
import "../transform/TransformModel.js" as Model
import "Fixtures.js" as Fx

// qmltestrunner scene for slice V7. Replays each fixture scene (control.py replies, as the backend produced them) through
// the model into TransformPanel, checks the state the panel must show, runs the mechanical text checks, and saves a PNG per
// scene and mode to /tmp/mouthtype-transform/. Fixtures.js is generated by render_transform.sh from transform/fixtures.
TestCase {
  id: tc

  name: "TransformPanel"
  when: windowShown
  visible: true
  width: 700
  height: 820

  property bool dark: false
  Binding { target: Theme; property: "forceDark"; value: tc.dark }

  Rectangle {
    id: stage
    anchors.fill: parent
    color: tc.dark ? "#2A2A2E" : "#E4E4E8"
    TransformPanel {
      id: panel
      x: 30
      y: 20
    }
  }
  SignalSpy { id: accepted; target: panel; signalName: "acceptRequested" }
  SignalSpy { id: copied; target: panel; signalName: "copyResultRequested" }
  SignalSpy { id: cancelled; target: panel; signalName: "cancelRequested" }
  SignalSpy { id: chosen; target: panel; signalName: "chosen" }
  SignalSpy { id: retried; target: panel; signalName: "retryRequested" }

  function replay(name) {
    var s = Model.empty()
    var steps = Fx.scenes[name].steps
    for (var i = 0; i < steps.length; i++) {
      var step = steps[i]
      if (step.op === "capture") s = Model.fromCapture(step.reply)
      else if (step.op === "status") s = Model.withStatus(s, step.reply)
      else if (step.op === "start") s = Model.runStarted(s, step.kind)
      else if (step.op === "run") {
        if (s.phase !== "running") s = Model.runStarted(s, step.reply.kind)
        s = Model.absorbRun(s, step.reply)
      } else if (step.op === "accepting") s = Model.accepting(s)
      else if (step.op === "accept") s = Model.absorbAccept(s, step.reply)
    }
    return s
  }

  function show(name) {
    panel.session = Model.empty()
    panel.session = replay(name)
    wait(50)
  }

  function named(item, objectName) {
    if (item.objectName === objectName) return item
    for (var i = 0; i < item.children.length; i++) {
      var found = named(item.children[i], objectName)
      if (found) return found
    }
    return null
  }

  function walk(item, found) {
    if (item.text !== undefined && item.font !== undefined && item.elide !== undefined && item.visible) found.push(item)
    for (var i = 0; i < item.children.length; i++) walk(item.children[i], found)
    return found
  }

  function chipEnabled() {
    var out = []
    for (var i = 0; i < panel.chipList.length; i++) out.push(panel.chipList[i].enabled)
    return out
  }

  function checkText(label) {
    var texts = walk(panel, [])
    verify(texts.length > 2, label + ": found " + texts.length + " texts")
    for (var i = 0; i < texts.length; i++) {
      var t = texts[i]
      if (t.text === "" || t.width <= 0) continue
      verify(t.font.pixelSize >= 10, label + ": below the floor: '" + t.text + "' " + t.font.pixelSize)
      compare(t.elide, Text.ElideNone, label + ": elide set on '" + t.text + "'")
      if (t.parent && t.parent.width > 0) verify(t.width <= t.parent.width + 0.5, label + ": overflows its parent: '" + t.text + "'")
    }
  }

  // ---- model ----------------------------------------------------------------------------------------------------

  function test_model_client_diff() {
    var diff = Model.clientDiff("a b c", "a c d")
    compare(diff.highlight, true)
    compare(diff.original.map(function(s) { return s.kind + ":" + s.text }).join("|"), "equal:a |removed:b |equal:c")
    compare(diff.result.map(function(s) { return s.kind + ":" + s.text }).join("|"), "equal:a c|added: d")
    compare(Model.addedRanges(diff).length, 1)
    compare(Model.addedRanges(diff)[0][0], 3)
    var wide = "x ".repeat(1100)
    compare(Model.clientDiff(wide, "y").highlight, false)
    compare(Model.addedRanges(Model.clientDiff(wide, "y")).length, 0)
  }

  function test_model_matches_backend_spans() {
    var s = replay("normal")
    compare(s.diff.highlight, true)
    var client = Model.clientDiff(s.original, s.serverResult)
    compare(Model.addedRanges(client).length, Model.addedRanges(s.diff).length)
  }

  function test_model_reducers() {
    var s = replay("ai-ready")
    compare(s.kind, "fix-grammar")
    compare(s.phase, "ready")
    var failed = Model.absorbRun(Model.runStarted(s, "make-shorter"), { state: "timeout", id: s.id, message: "Make shorter took too long." })
    compare(failed.kind, "fix-grammar", "a failed run keeps the previous choice")
    compare(failed.result, s.result)
    compare(failed.messageTone, "error")
    compare(Model.retryKind(failed), "make-shorter", "Retry repeats the transform that failed")
    compare(Model.retryVisible(failed), true)
    var cleanFailed = Model.absorbRun(Model.runStarted(replay("normal"), "fix-grammar"), { state: "error", message: "x" })
    compare(Model.retryKind(cleanFailed), "fix-grammar")
    compare(Model.canRetry(cleanFailed), true)
    compare(Model.retryKind(Model.runStarted(failed, "make-shorter")), "make-shorter")
    var cancelledRun = Model.absorbRun(Model.runStarted(s, "make-shorter"), { state: "cancelled" })
    compare(cancelledRun.kind, "fix-grammar")
    var refused = replay("refused")
    compare(refused.refused.title, "Mouthtype didn't replace the text in Slack.")
    compare(Model.canAccept(refused, refused.result), false)
    compare(Model.canCopy(refused, refused.result), true)
    compare(Model.chips(refused).every(function(c) { return !c.enabled }), true)
    compare(Model.fromCapture({ state: "error", message: "Nothing selected" }).phase, "error")
    compare(Model.retryVisible(replay("normal")), false)
    compare(Model.retryVisible(s), true)
  }

  // ---- scenes ---------------------------------------------------------------------------------------------------

  function test_normal() {
    show("normal")
    compare(panel.chipList.length, 5)
    compare(panel.chipList[0].active, true)
    compare(chipEnabled().every(function(e) { return e }), true)
    compare(named(panel, "accept").enabled, true)
    compare(named(panel, "accept").primary, true)
    compare(named(panel, "copyResult").primary, false)
    compare(named(panel, "retry").visible, false)
    compare(named(panel, "refused").visible, false)
    compare(named(panel, "busy").visible, false)
    verify(named(panel, "original").html.indexOf("<s>") >= 0, "removed words are struck through")
    var box = named(panel, "result")
    tryVerify(function() { return box.rects.length >= 2 }, 2000, "added characters are highlighted")
    for (var i = 0; i < box.rects.length; i++) verify(box.rects[i].width > 0 && box.rects[i].height > 0)
    compare(panel.resultText, "So the meeting is at three pm tomorrow. I think we should bring the report.")
  }

  function test_edit_redraws_highlights() {
    show("normal")
    var box = named(panel, "result")
    tryVerify(function() { return box.rects.length >= 2 }, 2000)
    var edit = box.editor
    edit.text = "So the meeting is at four pm tomorrow. I think we should bring the report."
    tryVerify(function() { return box.settled === edit.text }, 2000, "edit settles")
    tryVerify(function() { return box.rects.length >= 3 }, 2000, "the edited word is marked too")
    compare(panel.resultText, edit.text)
    accepted.clear()
    mouseClick(named(panel, "accept"))
    compare(accepted.count, 1)
    compare(panel.resultText, edit.text, "Accept reads the edited text")
  }

  function test_buttons_emit() {
    show("normal")
    copied.clear(); cancelled.clear(); chosen.clear()
    mouseClick(named(panel, "copyResult"))
    compare(copied.count, 1)
    mouseClick(named(panel, "cancel"))
    compare(cancelled.count, 1)
    panel.chosen("fix-grammar")
    compare(chosen.count, 1)
  }

  function test_ai_ready_has_retry() {
    show("ai-ready")
    compare(named(panel, "retry").visible, true)
    compare(named(panel, "retry").enabled, true)
    retried.clear()
    mouseClick(named(panel, "retry"))
    compare(retried.count, 1)
    compare(panel.chipList[1].active, true)
  }

  function test_ai_busy() {
    show("ai-busy")
    compare(named(panel, "busy").visible, true)
    compare(chipEnabled().every(function(e) { return !e }), true)
    compare(panel.chipList[1].active, true)
    compare(named(panel, "retry").visible, true)
    compare(named(panel, "retry").enabled, false)
    compare(named(panel, "accept").enabled, false)
    compare(named(panel, "copyResult").enabled, false)
    compare(named(panel, "cancel").enabled, true, "cancel works while a transform runs")
    cancelled.clear()
    mouseClick(named(panel, "cancel"))
    compare(cancelled.count, 1)
  }

  function test_refused() {
    show("refused")
    var notice = named(panel, "refused")
    compare(notice.visible, true)
    verify(notice.title.indexOf("Slack") >= 0, "the notice names the app")
    verify(notice.detail.indexOf("Copy the result instead") >= 0)
    compare(named(panel, "accept").enabled, false)
    compare(named(panel, "accept").primary, false)
    compare(named(panel, "copyResult").primary, true)
    compare(named(panel, "copyResult").enabled, true)
    accepted.clear()
    mouseClick(named(panel, "accept"))
    compare(accepted.count, 0, "a disabled Accept does nothing")
  }

  function test_model_missing() {
    show("model-missing")
    var enabled = chipEnabled()
    compare(enabled[0], true)
    compare(enabled.slice(1).every(function(e) { return !e }), true)
    var note = named(panel, "modelNote")
    compare(note.visible, true)
    verify(note.text.indexOf("Thorough") >= 0)
    compare(panel.chipList[1].reason.indexOf("Thorough") >= 0, true)
  }

  function test_over_cap() {
    show("over-cap")
    var box = named(panel, "result")
    wait(100)
    compare(box.rects.length, 0, "no highlights over the cap")
    var note = named(panel, "highlightNote")
    compare(note.visible, true)
    verify(note.text.indexOf("2,000") >= 0)
    verify(named(panel, "original").html.indexOf("<s>") < 0, "nothing is struck through over the cap")
    compare(named(panel, "accept").enabled, true)
    verify(box.height <= 240, "the result scrolls instead of growing past its cap")
  }

  function test_accepted() {
    show("accepted")
    compare(named(panel, "copyOriginal").visible, true)
    compare(named(panel, "cancel").text, "Close")
    compare(named(panel, "accept").enabled, false)
    compare(named(panel, "copyResult").enabled, true)
  }

  function test_capture_error() {
    show("capture-error")
    compare(named(panel, "accept").visible, false)
    compare(named(panel, "message").visible, true)
    verify(named(panel, "message").text.indexOf("Select up to 16,000") >= 0)
    compare(named(panel, "cancel").visible, true)
  }

  // ---- renders --------------------------------------------------------------------------------------------------

  property var saved: ({})
  readonly property var scenes: ["normal", "ai-ready", "ai-busy", "refused", "model-missing", "over-cap", "accepted", "capture-error"]

  function test_render_data() {
    var rows = []
    for (var i = 0; i < scenes.length; i++) {
      rows.push({ tag: scenes[i] + " light", scene: scenes[i], dark: false })
      rows.push({ tag: scenes[i] + " dark", scene: scenes[i], dark: true })
    }
    return rows
  }

  function test_render(data) {
    tc.dark = data.dark
    show(data.scene)
    wait(250)
    checkText(data.tag)
    var key = data.scene + "-" + (data.dark ? "dark" : "light")
    saved[key] = undefined
    stage.grabToImage(function(result) { saved[key] = result.saveToFile("/tmp/mouthtype-transform/" + key + ".png") })
    tryVerify(function() { return saved[key] !== undefined }, 3000, "grab never finished: " + key)
    verify(saved[key] === true, "could not save " + key)
  }
}
