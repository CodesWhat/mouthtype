#!/usr/bin/env python3
"""Testbed shim for `systemctl --user`: just enough for the Mouthtype plugin and Omarchy's scripts.

There is no systemd in the container. Units live in ~/.config/systemd/user like real ones. `enable` makes
the same graphical-session.target.wants symlink, `start` runs ExecStart under a small supervisor that
honours Restart=always and RestartSec, and the session start script starts every enabled unit.
"""
import os, shlex, signal, subprocess, sys, time
from pathlib import Path

HOME = Path.home()
UNITS = HOME / ".config/systemd/user"
STATE = HOME / ".local/state/testbed/units"


def unit_file(name):
    return UNITS / (name if "." in name else name + ".service")


def parse(path):
    section, values = None, {}
    for line in path.read_text().splitlines():
        line = line.strip()
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1]
        elif "=" in line and not line.startswith("#"):
            key, value = line.split("=", 1)
            values.setdefault((section, key), value)
    return values


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def read_pid(name):
    try:
        pid = int((STATE / (name + ".pid")).read_text())
    except (OSError, ValueError):
        return None
    return pid if alive(pid) else None


def supervise(name):
    values = parse(unit_file(name))
    command = shlex.split(values[("Service", "ExecStart")].replace("%%", "%"))
    restart = values.get(("Service", "Restart"), "no") in {"always", "on-failure"}
    delay = float(values.get(("Service", "RestartSec"), "1").rstrip("s") or 1)
    child = None

    def stop(*_):
        if child and child.poll() is None:
            child.terminate()
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    log = open(STATE / (name + ".log"), "ab")
    while True:
        child = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=log, stderr=log)
        child.wait()
        if not restart:
            return
        time.sleep(delay)


def start(name):
    if read_pid(name):
        return 0
    if not unit_file(name).is_file():
        print(f"Unit {name} not found.", file=sys.stderr)
        return 5
    STATE.mkdir(parents=True, exist_ok=True)
    proc = subprocess.Popen([sys.executable, __file__, "--supervise", name], start_new_session=True,
                            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    (STATE / (name + ".pid")).write_text(str(proc.pid))
    return 0


def stop_unit(name):
    pid = read_pid(name)
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        for _ in range(50):
            if not alive(pid):
                break
            time.sleep(0.1)
    return 0


def wants(name):
    return UNITS / "graphical-session.target.wants" / name


def main(argv):
    if argv[:1] == ["--supervise"]:
        supervise(argv[1])
        return 0
    args = [a for a in argv if not a.startswith("-")]
    flags = [a for a in argv if a.startswith("-")]
    if "--user" not in flags or not args:
        return 0
    verb, names = args[0], [n if "." in n else n + ".service" for n in args[1:]]
    if verb in {"daemon-reload", "import-environment", "set-environment", "reset-failed"}:
        return 0
    if verb == "show-environment":
        for key, value in os.environ.items():
            print(f"{key}={value}")
        return 0
    status = 0
    for name in names:
        if verb == "start":
            status = start(name) or status
        elif verb == "stop":
            stop_unit(name)
        elif verb in {"restart", "try-restart", "reload"}:
            if verb == "restart" or read_pid(name):
                stop_unit(name)
                status = start(name) or status
        elif verb == "is-active":
            active = read_pid(name) is not None
            if "--quiet" not in flags and "-q" not in flags:
                print("active" if active else "inactive")
            status = status or (0 if active else 3)
        elif verb == "is-enabled":
            enabled = wants(name).is_symlink()
            print("enabled" if enabled else "disabled")
            status = status or (0 if enabled else 1)
        elif verb == "enable":
            if not unit_file(name).is_file():
                print(f"Failed to enable unit: Unit file {name} does not exist.", file=sys.stderr)
                return 1
            wants(name).parent.mkdir(parents=True, exist_ok=True)
            if not wants(name).is_symlink():
                wants(name).symlink_to(unit_file(name))
            if "--now" in flags:
                start(name)
        elif verb == "disable":
            wants(name).unlink(missing_ok=True)
            (UNITS / "default.target.wants" / name).unlink(missing_ok=True)
            if "--now" in flags:
                stop_unit(name)
        elif verb == "status":
            print(f"{name}: {'active (running)' if read_pid(name) else 'inactive (dead)'}")
            status = status or (0 if read_pid(name) else 3)
        elif verb == "show":
            pass
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
