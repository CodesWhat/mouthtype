#!/usr/bin/env python3
"""Stand-in for the mouthtype-linux launcher in the host tests: `watch` reports a recording take, then idles."""
import json
import sys
import time

if "watch" in sys.argv:
    print(json.dumps({"event": "state", "state": "recording", "level": -30.0, "elapsed": 2.0}), flush=True)
    for _ in range(100):
        print(json.dumps({"event": "state", "state": "recording", "level": -20.0, "elapsed": 3.0}), flush=True)
        time.sleep(0.1)
