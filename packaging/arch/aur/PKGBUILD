# Maintainer: Scott Benson <scottrbenson at gmail dot com>
# Contributor: CodesWhat <https://github.com/CodesWhat>
#
# Development build of the Mouthtype Linux client and Omarchy bar plugin, built from git. Experimental:
# nothing here has been accepted on a wide range of hardware yet (see https://mouthtype.app/linux/).
# The branch is a build input: MOUTHTYPE_BRANCH=<branch> makepkg builds that branch, the default is main.
_branch=${MOUTHTYPE_BRANCH:-main}
pkgname=mouthtype-linux-git
pkgver=0.0.0
pkgrel=1
pkgdesc='Local voice dictation for Omarchy and Hyprland (development client)'
arch=('x86_64')
url='https://mouthtype.app/linux/'
license=('GPL-3.0-only' 'MIT' 'Unicode-3.0')
depends=('python' 'python-gobject' 'curl' 'pipewire-audio' 'wl-clipboard' 'wtype' 'libnotify' 'ffmpeg')
makedepends=('git')
optdepends=('hyprland: identify the active window for paste and type delivery (Omarchy ships it)'
            'git: only for mouthtype-linux-setup --build-server (compiles the AI cleanup server locally)'
            'cmake: only for mouthtype-linux-setup --build-server (compiles the AI cleanup server locally)'
            'base-devel: only for mouthtype-linux-setup --build-server (compiles the AI cleanup server locally)')
provides=("${pkgname%-git}")
conflicts=("${pkgname%-git}")
install=mouthtype-linux.install
source=("${pkgname%-git}::git+https://github.com/CodesWhat/mouthtype.git#branch=${_branch}")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/${pkgname%-git}"
    local base
    base=$(python -c "import plistlib; print(plistlib.load(open('packaging/Version.plist', 'rb'))['CFBundleShortVersionString'])")
    printf '%s.r%s.%s' "$base" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
    cd "$srcdir/${pkgname%-git}"
    python tools/linux-desktop/install.py --prefix /usr --destdir "$pkgdir"

    # Omarchy bar plugin: the runtime files only. mouthtype-linux-setup copies it into ~/.config/omarchy/plugins.
    local plugin="$pkgdir/usr/share/mouthtype-linux/omarchy-plugin" file
    while IFS= read -r -d '' file; do
        install -Dm644 "tools/omarchy-plugin/$file" "$plugin/$file"
    done < <(cd tools/omarchy-plugin && find . -type f \
        ! -name 'test_*' ! -name 'tst_*' ! -name 'gen_*' ! -name '*.pyc' \
        ! -path './*-render/*' ! -path './design/gallery/*' ! -path './design/render/*' \
        ! -path '*/fixtures/*' -print0)
    install -Dm644 packaging/Version.plist "$pkgdir/usr/share/mouthtype-linux/Version.plist"
    chmod 755 "$plugin/control.py" "$plugin/save_dialog.py" "$plugin/install.py"

    install -Dm755 packaging/arch/aur/mouthtype-linux-setup "$pkgdir/usr/bin/mouthtype-linux-setup"
    install -Dm644 packaging/arch/aur/mouthtype-linux.service "$pkgdir/usr/lib/systemd/user/mouthtype-linux.service"
    # First-run unit: enabled for every user (the same as `systemctl --global enable`), so the first login after
    # install runs the per-user setup. The logic lives in the client (`mouthtype-linux firstrun`), not here.
    install -Dm644 tools/linux-desktop/systemd/mouthtype-linux-firstrun.service \
        "$pkgdir/usr/lib/systemd/user/mouthtype-linux-firstrun.service"
    install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
    ln -s ../mouthtype-linux-firstrun.service \
        "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/mouthtype-linux-firstrun.service"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
    install -Dm644 tools/linux-desktop/vendor/grapheme/LICENSE "$pkgdir/usr/share/licenses/$pkgname/grapheme-MIT"
    install -Dm644 tools/linux-desktop/vendor/grapheme/UNICODE-LICENSE "$pkgdir/usr/share/licenses/$pkgname/Unicode-LICENSE"
}
