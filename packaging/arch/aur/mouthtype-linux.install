post_install() {
    cat <<'MSG'
==> Mouthtype is installed. Log in again (or run: systemctl --user start mouthtype-linux-firstrun) and it sets
==> itself up: speech model (about 465 MiB), Omarchy bar widget, the dictation (Super+Alt+M) and Transform
==> (Super+Shift+T) keys, and the login service. Progress and any failure show as notifications.
==> To repeat or repair that by hand as your normal user (not root): mouthtype-linux-setup
MSG
}

post_upgrade() {
    cat <<'MSG'
==> Mouthtype was upgraded. Log in again, or run mouthtype-linux-setup now.
MSG
}

pre_remove() {
    cat <<'MSG'
==> Removing Mouthtype. Per-user pieces (bar widget, login service link, shortcut blocks) live in your home
==> directory, so pacman leaves them. Run this as your normal user while the package is still installed:
==>     mouthtype-linux-setup --uninstall          (add --purge to also delete models and recordings)
MSG
}
